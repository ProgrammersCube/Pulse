# ===========================================
# PULSE BACKEND - MAINNET CONFIGURATION
# ===========================================
# Copy this file to .env and update with your actual values

# ===========================================
# NETWORK CONFIGURATION
# ===========================================
NODE_ENV=production
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# ===========================================
# WALLET CONFIGURATION (CRITICAL)
# ===========================================
# IMPORTANT: Create a NEW mainnet wallet - NEVER use testnet wallet on mainnet
# Generate with: solana-keygen new --outfile mainnet-house-wallet.json
HOUSE_WALLET_ADDRESS=YOUR_MAINNET_HOUSE_WALLET_PUBLIC_KEY
HOUSE_WALLET_PRIVATE_KEY=[YOUR,MAINNET,PRIVATE,KEY,ARRAY]

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# Generate strong 32+ character secrets
JWT_SECRET=your-super-secure-32-character-jwt-secret-key-here
SHARED_SECRET_For_PRIVATE_KEY=your-super-secure-32-character-shared-secret-here

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pulse-mainnet?retryWrites=true&w=majority

# ===========================================
# CORS CONFIGURATION
# ===========================================
FRONTEND_PRODUCTION_URL=https://thepulse.bet
FRONTEND_DEVELOPMENT_URL=http://localhost:3000

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=5000
HOST=0.0.0.0

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# PRICE FEED CONFIGURATION
# ===========================================
PYTH_PRICE_FEED_URL=https://hermes.pyth.network/v2/updates/price/latest
BINANCE_WEBSOCKET_URL=wss://stream.binance.com:9443/ws/btcusdt@ticker

# ===========================================
# GAME CONFIGURATION
# ===========================================
DEFAULT_GAME_DURATION=30
MAX_GAME_DURATION=60
MIN_BET_AMOUNT=0.001
MAX_BET_AMOUNT=100

# ===========================================
# TOKEN CONFIGURATION (MAINNET ADDRESSES)
# ===========================================
# These are already configured in code, but listed here for reference
# BeTyche: EydjnYHVeCQGihcvA22vBDCxn5HzBrXoQpP98kL9Koyp
# RADBRO: 287XY2FcGAE5ty4PZVjg22eqx37sEmzP8jPK3GxFofqB

# ===========================================
# ADMIN CONFIGURATION
# ===========================================
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-password-immediately

# ===========================================
# MONITORING & ANALYTICS
# ===========================================
ENABLE_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=90

# ===========================================
# BACKUP & RECOVERY
# ===========================================
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# ===========================================
# DEVELOPMENT/TESTING (Set to false in production)
# ===========================================
ENABLE_TEST_ROUTES=false
ENABLE_DEBUG_MODE=false
ENABLE_MOCK_TRANSACTIONS=false
