# Server Configuration
PORT=7000

# JWT Secret (MUST be at least 32 characters long)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long

# Database Connection (mongodb url)
MONGODB_URI=mongodb://username:password@host:port/database

# Environment (development, production)
NODE_ENV=development

# Frontend URLs
FRONTEND_URL=http://localhost:3000
FRONTEND_PRODUCTION_URL=https://your-production-frontend-url.com

# Solana House Wallet Configuration (it was usefull before wallet rotation feature)
HOUSE_WALLET_ADDRESS=YourSolanaWalletPublicKeyHere
HOUSE_WALLET_PRIVATE_KEY=YourSolanaWalletPrivateKeyHere

# Solana Blockchain Configuration 
# testmode
SOLANA_NETWORK=testnet
SOLANA_RPC_URL=https://api.testnet.solana.com
# mainnet
SOLANA_NETWORK=mainnet
SOLANA_RPC_URL=https://api.mainnet.solana.com
# AES-256 Encryption Secret for Wallet Private Keys
# CRITICAL: Must be at least 32 characters (256 bits) in production
# Used to encrypt/decrypt wallet private keys before database storage
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SHARED_SECRET_For_PRIVATE_KEY=your-32+-char-random-secret-for-AES-256-encryption

# SendGrid Email Configuration (add your verified sendgrid sender email and api key for forget password flow to work )
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_API_KEY=your-sendgrid-api-key-here

# Ambassador Payout Configuration
# Set to 'true' to enable on-chain payouts to ambassadors (disabled by default for security)
AMBASSADOR_PAYOUTS_ENABLED=false
