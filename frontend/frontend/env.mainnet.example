# ===========================================
# PULSE FRONTEND - MAINNET CONFIGURATION
# ===========================================
# Copy this file to .env and update with your actual values

# ===========================================
# NETWORK CONFIGURATION
# ===========================================
REACT_APP_SOLANA_NETWORK=mainnet
REACT_APP_API_URL=https://api.thepulse.bet
REACT_APP_SOCKET_URL=https://api.thepulse.bet
REACT_APP_FRONTEND_URL=https://thepulse.bet

# ===========================================
# RPC CONFIGURATION
# ===========================================
# Get your Helius API key from: https://helius.dev
REACT_APP_HELIUS_API_KEY=your-helius-api-key-here
REACT_APP_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# ===========================================
# WALLET CONFIGURATION
# ===========================================
# Reown AppKit Project ID (already configured in reown.js)
# Project ID: 089c16e7988ade6be6f2c8ba9531a604

# ===========================================
# TOKEN CONFIGURATION (MAINNET ADDRESSES)
# ===========================================
# These are already configured in Solana.js, but listed here for reference
# BeTyche: EydjnYHVeCQGihcvA22vBDCxn5HzBrXoQpP98kL9Koyp
# RADBRO: 287XY2FcGAE5ty4PZVjg22eqx37sEmzP8jPK3GxFofqB

# ===========================================
# UI CONFIGURATION
# ===========================================
REACT_APP_THEME=dark
REACT_APP_ENABLE_ANIMATIONS=true
REACT_APP_ENABLE_SOUNDS=true

# ===========================================
# GAME CONFIGURATION
# ===========================================
REACT_APP_DEFAULT_GAME_DURATION=30
REACT_APP_MAX_GAME_DURATION=60
REACT_APP_MIN_BET_AMOUNT=0.001
REACT_APP_MAX_BET_AMOUNT=100

# ===========================================
# ANALYTICS & MONITORING
# ===========================================
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ANALYTICS_ID=your-analytics-id

# ===========================================
# ERROR REPORTING
# ===========================================
REACT_APP_ENABLE_ERROR_REPORTING=true
REACT_APP_SENTRY_DSN=your-sentry-dsn

# ===========================================
# DEVELOPMENT/TESTING (Set to false in production)
# ===========================================
REACT_APP_ENABLE_DEBUG_MODE=false
REACT_APP_ENABLE_MOCK_DATA=false
REACT_APP_ENABLE_DEV_TOOLS=false

# ===========================================
# BUILD CONFIGURATION
# ===========================================
GENERATE_SOURCEMAP=false
REACT_APP_BUILD_ENV=production

# ===========================================
# SECURITY HEADERS
# ===========================================
REACT_APP_ENABLE_CSP=true
REACT_APP_ENABLE_HSTS=true

# ===========================================
# PERFORMANCE OPTIMIZATION
# ===========================================
REACT_APP_ENABLE_LAZY_LOADING=true
REACT_APP_ENABLE_CODE_SPLITTING=true
REACT_APP_ENABLE_SERVICE_WORKER=true

# ===========================================
# SOCIAL MEDIA & SEO
# ===========================================
REACT_APP_SITE_NAME=Pulse
REACT_APP_SITE_DESCRIPTION=Crypto Micro Prediction Game
REACT_APP_SITE_URL=https://thepulse.bet
REACT_APP_TWITTER_HANDLE=@pulse_bet

# ===========================================
# FEATURE FLAGS
# ===========================================
REACT_APP_ENABLE_REFERRAL_SYSTEM=true
REACT_APP_ENABLE_AMBASSADOR_SYSTEM=true
REACT_APP_ENABLE_ADMIN_DASHBOARD=true
REACT_APP_ENABLE_TREASURY_MANAGEMENT=true
